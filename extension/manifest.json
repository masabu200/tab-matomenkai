{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "__MSG_appDescription__",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "tabGroups",
    "unlimitedStorage",
    "sidePanel",
    "identity",
    "contextMenus"
  ],
  "version": "1.2.1",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.googleapis.com/*"
  ],
  "default_locale": "en"
}
